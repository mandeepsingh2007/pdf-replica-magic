# =============================================================================
# AI Test Generator - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# --- Application ---
APP_NAME="AI Test Generator"
APP_VERSION="1.0.0"
DEBUG=true

# --- Database ---
# SQLite (development):
DATABASE_URL="sqlite+aiosqlite:///./test_generator.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/test_generator"

# --- Redis & Celery ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# --- LLM API Keys ---
OPENAI_API_KEY="sk-your-openai-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# --- AWS / S3 ---
S3_BUCKET_NAME="test-generator-uploads"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# --- File Uploads ---
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=50

# --- LLM Configuration ---
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="text-embedding-3-small"

# --- CORS ---
# Local dev + your Vercel URL (add after deploy):
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
