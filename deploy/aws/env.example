# Copy to /opt/test-generator/.env on the EC2 instance (chmod 600)
GEMINI_API_KEY=your_gemini_key_here
DATABASE_URL=sqlite+aiosqlite:////data/test_generator.db
CORS_ORIGINS=["https://www.negraphics.in","https://negraphics.in"]
SKIP_IMAGE_EXPAND=1
SKIP_RUNTIME_VLM=1
LLM_MAX_CONCURRENT=1
MAX_LLM_CONTEXT_CHARS=8000
